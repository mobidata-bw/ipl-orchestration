{
  admin off
}

http://:80 {
  # index page
  handle / {
    root * /var/www/index-page
  }

  # IPL assets
  handle_path /datasets/* {
    root * /var/www/datasets
  }
  # Webcam
  # Relative redirect target, so that it also works behind a path prefix (e.g. /karten/ipl/webcam).
  handle /webcam {
    redir webcam/ permanent
  }
  handle_path /webcam/* {
    root * /var/www/webcam
    file_server browse
  }

  # OCPDB Images
  handle_path /ocpdb/images/* {
    root * /var/www/ocpdb
  }

  # Custom 429 body for the OCPDB bulk router, queried internally by Traefik's errors middleware
  # (not routed publicly). Traefik keeps the original 429 status code.
  handle /errors/ocpdb-bulk-429 {
    header Content-Type "text/plain; charset=utf-8"
    respond "{$OCPDB_BULK_RATE_LIMIT_MESSAGE}" 200
  }

  # private gbfs feeds. Access restricted via traefik
  handle_path /gbfs/* {
    root * /var/www/gbfs
  }

  # well-known URIs (security.txt, favicon.ico, etc.)
  handle /robots.txt {
    root * /var/www/well-known
  }
  handle /favicon.ico {
    root * /var/www/well-known
  }
  handle_path /.well-known/* {
    root * /var/www/well-known
  }

  # The brotli (.br) encoding is not included in the standard caddy distribution.
  encode zstd gzip
  file_server {
    precompressed gzip zstd br
  }
}

http://:81 {
  root * /var/goaccess/report
  encode zstd gzip
  file_server
}
